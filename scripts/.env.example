# ─── 식약처 식품안전나라 OpenAPI ──────────────────────
# 발급: https://openapi.foodsafetykorea.go.kr → 회원가입 → 인증키 신청 (즉시 승인)
MFDS_API_KEY=여기에_발급받은_인증키

# ─── Supabase ────────────────────────────────────────
# 프로젝트 설정 → API → URL / service_role key (anon key 아님!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbGciOi...your_service_role_key

# ─── 네이버 개발자 (쇼핑인사이트 트렌드 분석용, 선택) ──
# 발급: https://developers.naver.com/apps/#/register
# 가격 수집은 다나와 스크래핑 사용 (API 키 불필요)
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# ─── 쿠팡 파트너스 (선택 — 어필리에이트 수수료) ──────
# 발급: https://partners.coupang.com → 가입 → API 키 발급
# 아웃링크 클릭 시 3% 수수료 수익
COUPANG_ACCESS_KEY=your_access_key
COUPANG_SECRET_KEY=your_secret_key
