# ─── Supabase ────────────────────────────────────────
# Supabase 대시보드 → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key

# service_role 키 (서버사이드 전용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key

# ─── 식약처 식품안전나라 OpenAPI ──────────────────────
# 발급: https://openapi.foodsafetykorea.go.kr → 회원가입 → 인증키 신청
MFDS_API_KEY=여기에_발급받은_인증키

# ─── 네이버 개발자 (쇼핑 검색 API) ────────────────────
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# ─── 쿠팡 파트너스 (선택) ──────────────────────────────
# 발급: https://partners.coupang.com
COUPANG_ACCESS_KEY=your_access_key
COUPANG_SECRET_KEY=your_secret_key
