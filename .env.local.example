# ─── Supabase ────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API Keys (새 방식 키 — legacy JWT 키는 2027년 초 종료)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# publishable 키 (공개용, 브라우저에 나가도 됨) — 변수 이름은 예전 그대로
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# secret 키 (서버 전용, 절대 클라이언트에 노출 금지) — 변수 이름은 예전 그대로
# GitHub Actions 비밀값 SUPABASE_SERVICE_ROLE_KEY · SUPABASE_KEY 도 같은 값
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# 기록 주인 쿠키(cf_uid) 서명 키 — 긴 무작위 문자열. 없으면 SUPABASE_SERVICE_ROLE_KEY 에서 파생(개발용)
SESSION_SECRET=
# 서명 키를 바꿀 때만: 옛 키 (src/lib/actor.ts). 옮겨 가는 기간이 지나면 지운다
# SESSION_SECRET_PREVIOUS=

# ─── 식약처 식품안전나라 OpenAPI ──────────────────────
# 발급: https://openapi.foodsafetykorea.go.kr → 회원가입 → 인증키 신청
MFDS_API_KEY=여기에_발급받은_인증키

# ─── 네이버 개발자 (쇼핑 검색 API) ────────────────────
# 발급: https://developers.naver.com/apps/#/register
NAVER_CLIENT_ID=your_client_id
NAVER_CLIENT_SECRET=your_client_secret

# ─── 쿠팡 파트너스 (선택) ──────────────────────────────
# 발급: https://partners.coupang.com
COUPANG_ACCESS_KEY=your_access_key
COUPANG_SECRET_KEY=your_secret_key
